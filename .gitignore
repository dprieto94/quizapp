# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local-only seeds (datos reales)
db/*.local.sql

# local-only scripts (paths privados, fuentes fuera del repo)
scripts/import-preguntas.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local config
.claude/

# UI playground (no se commitea, vive solo en local)
src/app/dev-ui/

# Data smoke test (no se commitea, vive solo en local)
src/app/dev-data/
